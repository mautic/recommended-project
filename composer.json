{
  "name": "mautic/recommended-project",
  "description": "Inbox SOS - Production-ready Mautic 6 template for Railway.com with support for Amazon SES, Brevo, Mailgun, SendGrid, and Postmark",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "homepage": "https://www.mautic.org/mautic-releases",
  "support": {
    "user-docs": "https://docs.mautic.org/en",
    "developer-docs": "https://developer.mautic.org",
    "chat": "https://www.mautic.org/slack"
  },
  "funding": [
    {
      "type": "other",
      "url": "https://opencollective.com/mautic"
    },
    {
      "type": "other",
      "url": "https://github.com/sponsors/mautic"
    }
  ],
  "authors": [
    {
      "name": "",
      "role": ""
    }
  ],
  "require": {
    "composer/installers": "^1.11",
    "mautic/core-composer-scaffold": "4.x-dev",
    "mautic/core-project-message": "4.x-dev",
    "mautic/core-lib": "6.x-dev",
    "mautic/grapes-js-builder-bundle": "6.x-dev",
    "symfony/amazon-mailer": "^6.4|^7.0",
    "symfony/brevo-mailer": "^6.4|^7.0",
    "symfony/mailgun-mailer": "^6.4|^7.0",
    "symfony/sendgrid-mailer": "^6.4|^7.0",
    "symfony/postmark-mailer": "^6.4|^7.0",
    "predis/predis": "^2.0",
    "mautic/plugin-clearbit": "6.x-dev",
    "mautic/plugin-cloudstorage": "6.x-dev",
    "mautic/plugin-crm": "6.x-dev",
    "mautic/plugin-emailmarketing": "6.x-dev",
    "mautic/plugin-focus": "6.x-dev",
    "mautic/plugin-fullcontact": "6.x-dev",
    "mautic/plugin-gmail": "6.x-dev",
    "mautic/plugin-outlook": "6.x-dev",
    "mautic/plugin-social": "6.x-dev",
    "mautic/plugin-tagmanager": "6.x-dev",
    "mautic/plugin-zapier": "6.x-dev",
    "mautic/theme-1-2-1-2-column": "6.x-dev",
    "mautic/theme-1-2-1-column": "6.x-dev",
    "mautic/theme-1-2-column": "6.x-dev",
    "mautic/theme-1-3-1-3-column": "6.x-dev",
    "mautic/theme-1-3-column": "6.x-dev",
    "mautic/theme-attract": "6.x-dev",
    "mautic/theme-aurora": "6.x-dev",
    "mautic/theme-blank": "6.x-dev",
    "mautic/theme-blend": "6.x-dev",
    "mautic/theme-brienz": "6.x-dev",
    "mautic/theme-capture": "6.x-dev",
    "mautic/theme-cards": "6.x-dev",
    "mautic/theme-chord": "6.x-dev",
    "mautic/theme-confirmme": "6.x-dev",
    "mautic/theme-connect-through-content": "6.x-dev",
    "mautic/theme-creative": "6.x-dev",
    "mautic/theme-eclipse": "6.x-dev",
    "mautic/theme-educate": "6.x-dev",
    "mautic/theme-formscape": "6.x-dev",
    "mautic/theme-fresh-center": "6.x-dev",
    "mautic/theme-fresh-fixed": "6.x-dev",
    "mautic/theme-fresh-left": "6.x-dev",
    "mautic/theme-fresh-wide": "6.x-dev",
    "mautic/theme-gallery": "6.x-dev",
    "mautic/theme-goldstar": "6.x-dev",
    "mautic/theme-make-announcement": "6.x-dev",
    "mautic/theme-mono": "6.x-dev",
    "mautic/theme-neopolitan": "6.x-dev",
    "mautic/theme-oxygen": "6.x-dev",
    "mautic/theme-paprika": "6.x-dev",
    "mautic/theme-reachout": "6.x-dev",
    "mautic/theme-showcase": "6.x-dev",
    "mautic/theme-simple-text": "6.x-dev",
    "mautic/theme-skyline": "6.x-dev",
    "mautic/theme-sparse": "6.x-dev",
    "mautic/theme-sunday": "6.x-dev",
    "mautic/theme-survey": "6.x-dev",
    "mautic/theme-trulypersonal": "6.x-dev",
    "mautic/theme-vibrant": "6.x-dev",
    "mautic/theme-welcome": "6.x-dev"
  },
  "repositories": [
    {
      "type": "git",
      "url": "https://github.com/mautic/SymfonyBridgeBundle.git"
    }
  ],
  "conflict": {
    "mautic/mautic": "*",
    "mautic/core": "*"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "symfony/flex": true,
      "mautic/core-composer-scaffold": true,
      "mautic/core-project-message": true,
      "php-http/discovery": true
    }
  },
  "autoload": {
    "psr-4": {
      "MauticPlugin\\": "docroot/plugins/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@npm-ci",
      "@npx-patch-package",
      "@generate-assets"
    ],
    "post-update-cmd": [
      "@npm-ci",
      "@npx-patch-package",
      "@generate-assets"
    ],
    "npm-ci": "npm ci --prefer-offline --no-audit --ignore-scripts || npm install --no-audit --ignore-scripts",
    "npx-patch-package": "npx patch-package || true",
    "generate-assets": "@php bin/console mautic:assets:generate --no-interaction || true"
  },
  "extra": {
    "mautic-scaffold": {
      "locations": {
        "web-root": "docroot/"
      }
    },
    "installer-paths": {
      "docroot/app": [
        "type:mautic-core"
      ],
      "docroot/plugins/{$name}": [
        "type:mautic-plugin"
      ],
      "docroot/themes/{$name}": [
        "type:mautic-theme"
      ]
    },
    "mautic-core-project-message": {
      "include-keys": [
        "homepage",
        "support"
      ],
      "post-create-project-cmd-message": [
        "<bg=blue;fg=white>                                                         </>",
        "<bg=blue;fg=white>  Inbox SOS - Mautic 6 for Railway.com                  </>",
        "<bg=blue;fg=white>  Production-ready email marketing automation            </>",
        "<bg=blue;fg=white>                                                         </>",
        "",
        "<bg=yellow;fg=black>Next steps</>:",
        "  * Deploy to Railway.com",
        "  * Complete web-based setup wizard",
        "  * Configure your ESP (SES, Brevo, Mailgun, SendGrid, Postmark)",
        "  * Read the deployment guide in README.md",
        "  * Get support: https://www.mautic.org/support"
      ]
    }
  }
}
