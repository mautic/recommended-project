# ==============================================================================
# Inbox SOS - Mautic 6 Environment Configuration for Railway.com
# ==============================================================================
#
# This file contains all environment variables needed for deploying Mautic 6
# on Railway.com. Railway will auto-populate DATABASE_URL and REDIS_URL when
# you add MySQL and Redis services to your project.
#
# IMPORTANT: Most of these are auto-configured by Railway. You only need to
# manually set the ones marked as "REQUIRED" below.
#
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (Auto-configured by Railway MySQL service)
# ------------------------------------------------------------------------------
# Railway will automatically provide DATABASE_URL when you add MySQL service
# Format: mysql://user:password@host:port/database
DATABASE_URL=mysql://root:password@mysql:3306/mautic

# Alternative: Individual database variables (if not using DATABASE_URL)
# MAUTIC_DB_HOST=mysql
# MAUTIC_DB_PORT=3306
# MAUTIC_DB_NAME=mautic
# MAUTIC_DB_USER=root
# MAUTIC_DB_PASSWORD=
# MAUTIC_DB_TABLE_PREFIX=

# ------------------------------------------------------------------------------
# REDIS CONFIGURATION (Auto-configured by Railway Redis service)
# ------------------------------------------------------------------------------
# Railway will automatically provide REDIS_URL when you add Redis service
# Format: redis://host:port/database
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# MAUTIC SITE CONFIGURATION
# ------------------------------------------------------------------------------
# Railway automatically sets RAILWAY_PUBLIC_DOMAIN with your app's URL
# The startup script uses this to configure Mautic's site URL
# RAILWAY_PUBLIC_DOMAIN=your-app.railway.app

# Optional: Override the site URL if needed
# MAUTIC_SITE_URL=https://your-custom-domain.com

# ------------------------------------------------------------------------------
# SECURITY SETTINGS
# ------------------------------------------------------------------------------
# REQUIRED: Generate a random secret key (Railway can generate this for you)
# You can generate one with: openssl rand -hex 32
MAUTIC_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_STRING_AT_LEAST_32_CHARS

# Trusted proxies (Railway uses proxies, this is configured automatically)
# MAUTIC_TRUSTED_PROXIES=0.0.0.0/0

# ------------------------------------------------------------------------------
# EMAIL SENDER CONFIGURATION (REQUIRED - Configure after deployment)
# ------------------------------------------------------------------------------
# These are the default "from" details for emails sent by Mautic
# You can also configure these through the Mautic UI after deployment

MAILER_FROM_NAME="Your Company Name"
MAILER_FROM_EMAIL=noreply@yourdomain.com

# ------------------------------------------------------------------------------
# EMAIL SERVICE PROVIDER (ESP) CONFIGURATION
# ------------------------------------------------------------------------------
# Configure ONE of the following based on your chosen ESP
# Detailed configuration guides are in docs/ESP_CONFIGURATION.md
#
# IMPORTANT: You can also configure these through the Mautic UI at:
# Settings > Configuration > Email Settings

# --- Amazon SES ---
# After installing the Amazon SES Bundle plugin, configure via Mautic UI or:
# DSN Format: mautic+ses+api://ACCESS_KEY:SECRET_KEY@default?region=us-east-1
# MAILER_DSN=mautic+ses+api://YOUR_ACCESS_KEY:YOUR_SECRET_KEY@default?region=us-east-1

# --- Brevo (formerly Sendinblue) ---
# DSN Format: brevo+api://API_KEY@default
# MAILER_DSN=brevo+api://YOUR_API_KEY@default

# --- Mailgun ---
# DSN Format: mailgun+https://API_KEY:DOMAIN@default?region=us
# MAILER_DSN=mailgun+https://YOUR_API_KEY:YOUR_DOMAIN@default?region=us

# --- SendGrid ---
# DSN Format: sendgrid+api://API_KEY@default
# MAILER_DSN=sendgrid+api://YOUR_API_KEY@default

# --- Postmark ---
# DSN Format: postmark+api://API_KEY@default
# MAILER_DSN=postmark+api://YOUR_API_KEY@default

# --- SMTP (Generic - works with any ESP) ---
# DSN Format: smtp://user:pass@host:port
# MAILER_DSN=smtp://username:password@smtp.example.com:587

# ------------------------------------------------------------------------------
# LOCALIZATION
# ------------------------------------------------------------------------------
MAUTIC_TIMEZONE=UTC
MAUTIC_LOCALE=en_US

# ------------------------------------------------------------------------------
# PERFORMANCE & SCALING SETTINGS
# ------------------------------------------------------------------------------
# These are optimized for production use and work for all deployment sizes

# PHP Memory Limit (already set in Dockerfile, but can override)
# PHP_MEMORY_LIMIT=512M

# Queue Processing Mode
# Options: immediate_process, command_process
# MAUTIC_QUEUE_MODE=immediate_process

# Max entity lock time (set to 0 for no locking issues)
# MAUTIC_MAX_ENTITY_LOCK_TIME=0

# ------------------------------------------------------------------------------
# API SETTINGS
# ------------------------------------------------------------------------------
# Enable API access for integrations
MAUTIC_API_ENABLED=true
MAUTIC_API_ENABLE_BASIC_AUTH=true

# ------------------------------------------------------------------------------
# TRACKING & PRIVACY SETTINGS
# ------------------------------------------------------------------------------
# Track contacts by IP (consider privacy regulations)
MAUTIC_TRACK_BY_IP=false

# Track by tracking URL (recommended)
MAUTIC_TRACK_BY_URL=true

# ------------------------------------------------------------------------------
# IMAGE & FILE UPLOAD SETTINGS
# ------------------------------------------------------------------------------
# Maximum upload size in MB
MAUTIC_MAX_SIZE=6

# Image path (relative to docroot)
MAUTIC_IMAGE_PATH=media/images

# ------------------------------------------------------------------------------
# ADVANCED SETTINGS (Optional)
# ------------------------------------------------------------------------------
# Update stability (options: alpha, beta, rc, stable)
MAUTIC_UPDATE_STABILITY=stable

# Enable verbose logging for debugging (not recommended for production)
# MAUTIC_DEBUG=false

# Log level (emergency, alert, critical, error, warning, notice, info, debug)
# MAUTIC_LOG_LEVEL=error

# ------------------------------------------------------------------------------
# CUSTOM DOMAIN SETUP (Optional)
# ------------------------------------------------------------------------------
# If you're using a custom domain with Railway:
# 1. Add your custom domain in Railway dashboard
# 2. Update MAUTIC_SITE_URL above to your custom domain
# 3. Configure your ESP to verify your domain for email sending
# 4. Set up DKIM, SPF, and DMARC records for better deliverability

# ==============================================================================
# DEPLOYMENT NOTES
# ==============================================================================
#
# 1. DATABASE & REDIS: Railway will auto-configure these when you add the
#    MySQL and Redis services to your project. No manual configuration needed!
#
# 2. FIRST-TIME SETUP: After deployment, visit your Railway public URL to
#    complete the Mautic setup wizard and create your admin account.
#
# 3. ESP CONFIGURATION: Choose your email service provider and configure it
#    through the Mautic UI at: Settings > Configuration > Email Settings
#    Detailed guides available in docs/ESP_CONFIGURATION.md
#
# 4. SECURITY: Make sure to generate a strong MAUTIC_SECRET_KEY before
#    deploying to production.
#
# 5. CUSTOM DOMAINS: For production use, set up a custom domain in Railway
#    and configure your ESP's domain verification.
#
# ==============================================================================
