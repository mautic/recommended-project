################################################################################
# MAUTIC 6 PRODUCTION-READY ENVIRONMENT CONFIGURATION
#
# This is a comprehensive configuration template for deploying Mautic 6
# on Railway.app with support for all major Email Service Providers (ESPs).
#
# INSTRUCTIONS FOR NON-TECHNICAL USERS:
# 1. Copy this file to .env (without .example)
# 2. Fill in the values marked as REQUIRED
# 3. Choose ONE email provider section and fill in those credentials
# 4. Deploy to Railway.app using the deployment guide
################################################################################

################################################################################
# CORE MAUTIC CONFIGURATION (REQUIRED)
################################################################################

# Application Environment
# Options: prod (for production), dev (for development/testing)
APP_ENV=prod

# Secret key for encryption - MUST be unique and secure
# Generate with: php -r "echo bin2hex(random_bytes(16));"
# Or use: https://www.random.org/strings/?num=1&len=32&digits=on&loweralpha=on&unique=on&format=html&rnd=new
APP_SECRET=CHANGE_THIS_TO_A_RANDOM_32_CHARACTER_STRING

# Site URL - Your public Mautic URL (provided by Railway)
# Example: https://your-app-name.up.railway.app
# IMPORTANT: No trailing slash!
MAUTIC_URL=https://your-railway-app-url.up.railway.app

# Trusted Proxies and Hosts (for Railway.app)
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
TRUSTED_HOSTS=^(.+\.)?up\.railway\.app$

################################################################################
# DATABASE CONFIGURATION (REQUIRED)
# Railway provides these automatically via DATABASE_URL
################################################################################

# Railway MySQL/MariaDB connection
# Railway automatically provides: DATABASE_URL
# Format: mysql://user:password@host:port/database?serverVersion=mariadb-11.4.0
#
# If Railway provides DATABASE_URL, you can use it directly:
DATABASE_URL=${DATABASE_URL}

# OR manually configure (if not using Railway's database):
# DATABASE_URL=mysql://mautic_user:your_password@localhost:3306/mautic_db?serverVersion=8.0

################################################################################
# EMAIL/MAILER CONFIGURATION
# Choose ONE provider below and uncomment its section
################################################################################

# Default "From" email address for all Mautic emails
MAILER_FROM_EMAIL=noreply@yourdomain.com
MAILER_FROM_NAME="Your Company Name"

# ------------------------------------------------------------------------------
# OPTION 1: Amazon SES (AWS)
# ------------------------------------------------------------------------------
# Required packages: symfony/amazon-mailer (already included)
# MAILER_DSN=ses+smtp://ACCESS_KEY:SECRET_KEY@default?region=us-east-1
#
# Or with SMTP:
# MAILER_DSN=ses+smtp://ACCESS_KEY:SECRET_KEY@default?region=us-east-1

# ------------------------------------------------------------------------------
# OPTION 2: SendGrid
# ------------------------------------------------------------------------------
# Required packages: symfony/sendgrid-mailer (already included)
# Get API key from: https://app.sendgrid.com/settings/api_keys
# MAILER_DSN=sendgrid+api://YOUR_API_KEY@default

# Or with SMTP:
# MAILER_DSN=sendgrid+smtp://apikey:YOUR_API_KEY@default

# ------------------------------------------------------------------------------
# OPTION 3: Mailgun
# ------------------------------------------------------------------------------
# Required packages: symfony/mailgun-mailer (already included)
# Get credentials from: https://app.mailgun.com/app/account/security/api_keys
# MAILER_DSN=mailgun+https://API_KEY:DOMAIN@default?region=us
#
# For EU region:
# MAILER_DSN=mailgun+https://API_KEY:DOMAIN@default?region=eu

# Or with SMTP:
# MAILER_DSN=mailgun+smtp://USERNAME:PASSWORD@default?region=us

# ------------------------------------------------------------------------------
# OPTION 4: Postmark
# ------------------------------------------------------------------------------
# Required packages: symfony/postmark-mailer (already included)
# Get API token from: https://account.postmarkapp.com/servers/XXXXX/credentials
# MAILER_DSN=postmark+api://SERVER_TOKEN@default
#
# Or with SMTP:
# MAILER_DSN=postmark+smtp://SERVER_TOKEN@default

# ------------------------------------------------------------------------------
# OPTION 5: Mailjet
# ------------------------------------------------------------------------------
# Required packages: symfony/mailjet-mailer (already included)
# Get credentials from: https://app.mailjet.com/account/api_keys
# MAILER_DSN=mailjet+api://API_KEY:SECRET_KEY@default
#
# Or with SMTP:
# MAILER_DSN=mailjet+smtp://API_KEY:SECRET_KEY@default

# ------------------------------------------------------------------------------
# OPTION 6: SparkPost
# ------------------------------------------------------------------------------
# Required packages: symfony/sparkpost-mailer (already included)
# Get API key from: https://app.sparkpost.com/account/api-keys
# MAILER_DSN=sparkpost+https://API_KEY@default
#
# Or with SMTP:
# MAILER_DSN=sparkpost+smtp://SMTP_INJECTION_PASSWORD@default

# ------------------------------------------------------------------------------
# OPTION 7: Brevo (formerly Sendinblue)
# ------------------------------------------------------------------------------
# Required packages: symfony/brevo-mailer (already included)
# Get API key from: https://account.brevo.com/advanced/api
# MAILER_DSN=brevo+api://API_KEY@default
#
# Or with SMTP:
# MAILER_DSN=brevo+smtp://USERNAME:PASSWORD@default

# ------------------------------------------------------------------------------
# OPTION 8: MailerSend
# ------------------------------------------------------------------------------
# Required packages: symfony/mailersend-mailer (already included)
# Get API token from: https://www.mailersend.com/
# MAILER_DSN=mailersend+api://API_TOKEN@default
#
# Or with SMTP:
# MAILER_DSN=mailersend+smtp://USERNAME:PASSWORD@default

# ------------------------------------------------------------------------------
# OPTION 9: Resend
# ------------------------------------------------------------------------------
# Required packages: symfony/resend-mailer (already included)
# Get API key from: https://resend.com/api-keys
# MAILER_DSN=resend+api://API_KEY@default
#
# Or with SMTP:
# MAILER_DSN=resend+smtp://resend:API_KEY@smtp.resend.com:587

# ------------------------------------------------------------------------------
# OPTION 10: Google Gmail API
# ------------------------------------------------------------------------------
# Required packages: symfony/google-mailer (already included)
# Setup OAuth2 credentials: https://console.cloud.google.com/apis/credentials
# MAILER_DSN=gmail+smtp://USERNAME:APP_PASSWORD@default
#
# Or with OAuth:
# MAILER_DSN=gmail+api://CLIENT_ID:CLIENT_SECRET:REFRESH_TOKEN@default

# ------------------------------------------------------------------------------
# OPTION 11: Infobip
# ------------------------------------------------------------------------------
# Required packages: symfony/infobip-mailer (already included)
# Get API key from: https://portal.infobip.com/dev/api-keys
# MAILER_DSN=infobip+api://API_KEY@BASE_URL

# ------------------------------------------------------------------------------
# OPTION 12: Scaleway (Transactional Email)
# ------------------------------------------------------------------------------
# Required packages: symfony/scaleway-mailer (already included)
# Get credentials from: https://console.scaleway.com/project/credentials
# MAILER_DSN=scaleway+api://PROJECT_ID:API_TOKEN@default?region=fr-par

# ------------------------------------------------------------------------------
# OPTION 13: MailPace
# ------------------------------------------------------------------------------
# Required packages: symfony/mailpace-mailer (already included)
# Get API token from: https://app.mailpace.com/
# MAILER_DSN=mailpace+api://API_TOKEN@default

# ------------------------------------------------------------------------------
# OPTION 14: Generic SMTP (Any Provider)
# ------------------------------------------------------------------------------
# Use this for any SMTP provider not listed above
# Common providers: Office365, Outlook, Yahoo, custom mail servers
# MAILER_DSN=smtp://USERNAME:PASSWORD@smtp.example.com:587?encryption=tls
#
# For Office 365:
# MAILER_DSN=smtp://your-email@domain.com:password@smtp.office365.com:587?encryption=tls
#
# For Gmail SMTP:
# MAILER_DSN=smtp://your-email@gmail.com:app-password@smtp.gmail.com:587?encryption=tls
#
# For custom server with SSL:
# MAILER_DSN=smtp://username:password@mail.yourserver.com:465?encryption=ssl

################################################################################
# PERFORMANCE & CACHING (RECOMMENDED FOR PRODUCTION)
################################################################################

# Redis Cache (highly recommended for Railway)
# Railway provides Redis - use the REDIS_URL environment variable
# REDIS_URL=redis://default:password@redis-host:6379

# Session storage
SESSION_STORAGE=redis
SESSION_SAVE_PATH=tcp://redis-host:6379

# Doctrine cache
DOCTRINE_CACHE_DRIVER=redis
DOCTRINE_CACHE_CONNECTION=tcp://redis-host:6379

################################################################################
# QUEUE CONFIGURATION (RECOMMENDED FOR PRODUCTION)
################################################################################

# Message queue for async processing
# Options: sync (no queue), doctrine (database), redis (recommended)
MESSENGER_TRANSPORT_DSN=doctrine://default

# For Redis queue (recommended):
# MESSENGER_TRANSPORT_DSN=redis://redis-host:6379/messages

################################################################################
# CRON/BACKGROUND JOBS CONFIGURATION
################################################################################

# Run these commands periodically (Railway cron or external service)
# */5 * * * * php /app/docroot/bin/console mautic:segments:update
# */5 * * * * php /app/docroot/bin/console mautic:campaigns:update
# */5 * * * * php /app/docroot/bin/console mautic:campaigns:trigger
# 10 2 * * * php /app/docroot/bin/console mautic:emails:send
# 15 2 * * * php /app/docroot/bin/console mautic:broadcasts:send
# 20 2 * * * php /app/docroot/bin/console doctrine:migrations:migrate --no-interaction

################################################################################
# SECURITY SETTINGS
################################################################################

# CORS settings (if using API)
MAUTIC_CORS_VALID_ORIGINS=^https?://(localhost|127\.0\.0\.1|.*\.railway\.app)(:[0-9]+)?$

# Cookie secure flag (always true for HTTPS)
MAUTIC_COOKIE_SECURE=1

# Cookie samesite policy
MAUTIC_COOKIE_SAMESITE=lax

################################################################################
# FILE STORAGE (OPTIONAL)
################################################################################

# Local storage (default)
# For production, consider using S3 or similar via CloudStorage plugin

# Amazon S3 (if using CloudStorage plugin)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=your-bucket-name
# AWS_S3_REGION=us-east-1

################################################################################
# MONITORING & LOGGING
################################################################################

# Log level: DEBUG, INFO, NOTICE, WARNING, ERROR, CRITICAL, ALERT, EMERGENCY
MAUTIC_LOG_LEVEL=WARNING

# Enable detailed error pages (set to 0 in production)
APP_DEBUG=0

################################################################################
# LOCALE & TIMEZONE
################################################################################

# Default locale
MAUTIC_LOCALE=en_US

# Default timezone (see: https://www.php.net/manual/en/timezones.php)
MAUTIC_TIMEZONE=America/New_York

################################################################################
# PHP CONFIGURATION OVERRIDES
################################################################################

# Memory limit (Railway allows up to 8GB depending on plan)
PHP_MEMORY_LIMIT=512M

# Maximum execution time
PHP_MAX_EXECUTION_TIME=300

# Upload limits
PHP_UPLOAD_MAX_FILESIZE=64M
PHP_POST_MAX_SIZE=64M

################################################################################
# RAILWAY-SPECIFIC SETTINGS
################################################################################

# Railway automatically provides:
# - PORT (the port your app should listen on)
# - RAILWAY_ENVIRONMENT (production, staging, etc.)
# - RAILWAY_SERVICE_NAME
# - DATABASE_URL (if you add a database service)
# - REDIS_URL (if you add a Redis service)

# These are auto-injected by Railway - no need to set them manually

################################################################################
# INSTALLATION HELPER
################################################################################

# First-time installation mode
# Set to 1 for initial setup, then change to 0 after installation
MAUTIC_INSTALL_MODE=0

# Admin user credentials (for automated installation)
# Only used if MAUTIC_INSTALL_MODE=1
# MAUTIC_ADMIN_USERNAME=admin
# MAUTIC_ADMIN_PASSWORD=ChangeThisPassword123!
# MAUTIC_ADMIN_EMAIL=admin@yourdomain.com
# MAUTIC_ADMIN_FIRSTNAME=Admin
# MAUTIC_ADMIN_LASTNAME=User

################################################################################
# END OF CONFIGURATION
################################################################################
